<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="24dp" android:background="#05070A">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="BLENDER FILE VIEWER" android:textColor="#FF9800"
        android:textSize="24sp" android:typeface="monospace" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Android .blend file manager" android:textColor="#FFCC80" android:paddingTop="8dp" />
    <Button android:id="@+id/openBlend" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="OPEN .BLEND FILE" android:layout_marginTop="18dp" />
    <Button android:id="@+id/questTerminal" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="OPEN QUEST TERMINAL" />
    <TextView android:id="@+id/blendStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="No Blender file selected" android:textColor="#D8F3DC" android:typeface="monospace" android:paddingTop="18dp" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="This app stores .blend files locally. A native Blender renderer is not bundled; use a compatible Android viewer/editor to render or edit the file."
        android:textColor="#90A4AE" android:paddingTop="18dp" />
</LinearLayout>
