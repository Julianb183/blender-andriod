<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.julianb183.questterminal"
    android:versionCode="2"
    android:versionName="0.2.0" >

    <uses-sdk
        android:minSdkVersion="29"
        android:targetSdkVersion="35" />

    <application
        android:allowBackup="false"
        android:debuggable="true"
        android:extractNativeLibs="false"
        android:label="Quest Terminal Blender Viewer"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="false" >
        <activity
            android:name="com.julianb183.questterminal.WindowsEmulatorActivity"
            android:exported="false"
            android:screenOrientation="landscape" />
        <activity
            android:name="com.julianb183.questterminal.MainActivity"
            android:exported="false"
            android:screenOrientation="landscape" >
        </activity>
        <activity
            android:name="com.julianb183.questterminal.BlenderActivity"
            android:exported="true"
            android:screenOrientation="landscape" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>