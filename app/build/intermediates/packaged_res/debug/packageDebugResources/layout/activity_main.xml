<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="16dp" android:background="#05070A">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="PCVR QUEST EMU  •  trusted-site mode" android:textColor="#00E5FF"
        android:textSize="18sp" android:typeface="monospace" android:paddingBottom="8dp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <EditText android:id="@+id/urlInput" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:hint="https://trusted-site.example" android:singleLine="true" android:text="https://mbf.quest/"
            android:textColor="#FFFFFF" android:textColorHint="#78909C" android:inputType="textUri" />
        <Button android:id="@+id/loadButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="LOAD" />
    </LinearLayout>
    <Button android:id="@+id/windowsButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="WINDOWS ARM64 EXPERIMENT" />
    <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="No device bridge connected" android:textColor="#FFCC80" android:textSize="13sp" android:typeface="monospace" android:paddingTop="6dp" android:paddingBottom="6dp" />
    <WebView android:id="@+id/webView" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
</LinearLayout>
